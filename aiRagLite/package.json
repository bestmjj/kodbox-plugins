{
  "id": "aiRagLite",
  "name": "AI 智能检索（自建）",
  "title": "AI 智能检索（自建）",
  "version": "0.5.0",
  "category": "tools",
  "source": {
    "className": "font-icon ri-search-eye-line bg-blue-6"
  },
  "description": "KodBox AI 智能检索及数字资产实时查询；新增在当前管理员会话中生成、预览、编辑并保存 Markdown/Word 文档。RAG WebDAV 索引账户保持只读。",
  "auther": {
    "copyright": "Community MVP",
    "homePage": "https://github.com/kalcaddle/kodbox"
  },
  "configItem": {
    "pluginAuth": {
      "type": "userSelect",
      "value": {
        "user": 1
      },
      "className": "hidden",
      "display": "使用权限",
      "require": 1
    },
    "serviceUrl": {
      "type": "input",
      "value": "http://rag-api:8787",
      "display": "RAG 服务内网地址",
      "desc": "Docker 共用私有网络时填写 http://rag-api:8787，切勿指向公开未经保护的 API。",
      "require": 1
    },
    "serviceKey": {
      "type": "input",
      "value": "",
      "display": "RAG 服务访问密钥",
      "desc": "与 .env 中 RAG_API_KEY 完全一致。仅 KodBox 服务端会读取，不发送给浏览器。",
      "require": 1
    }
  }
}
