{
  "id": "aiRagLite",
  "name": "AI 智能检索（自建）",
  "title": "AI 智能检索（自建）",
  "version": "0.4.0",
  "category": "tools",
  "source": {
    "className": "font-icon ri-search-eye-line bg-blue-6"
  },
  "description": "Kodbox 管理员智能检索：原有 WebDAV 文档 RAG 与 AssetLedger 实时资产盘点、关联查询、待核实清单共用入口；资产数据只在 Kodbox 服务端读取，不发送给文档 RAG 或外部 AI。",
  "auther": {
    "copyright": "Community MVP",
    "homePage": "https://github.com/kalcaddle/kodbox"
  },
  "configItem": {
    "pluginAuth": {
      "type": "userSelect",
      "value": {
        "user": 1
      },
      "className": "hidden",
      "display": "使用权限",
      "require": 1
    },
    "serviceUrl": {
      "type": "input",
      "value": "http://rag-api:8787",
      "display": "RAG 服务内网地址",
      "desc": "Docker 共用私有网络时填写 http://rag-api:8787，切勿指向公开未经保护的 API。",
      "require": 1
    },
    "serviceKey": {
      "type": "input",
      "value": "",
      "display": "RAG 服务访问密钥",
      "desc": "与 .env 中 RAG_API_KEY 完全一致。仅 KodBox 服务端会读取，不发送给浏览器。",
      "require": 1
    }
  }
}
