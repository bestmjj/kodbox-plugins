{
  "id": "aiRagLite",
  "name": "AI 智能检索（自建）",
  "title": "AI 智能检索（自建）",
  "version": "0.7.0",
  "category": "tools",
  "source": {
    "className": "font-icon ri-search-eye-line bg-blue-6"
  },
  "description": "KodBox AI 助手：以聊天为入口，支持关联文档后总结/连续问答/费用多币种核算，自动查 RAG 和本地数字资产。修改文章由 AI 提建议、差异确认后保存。当前 admin 会话授权，rag_reader 保持只读。",
  "auther": {
    "copyright": "Community MVP",
    "homePage": "https://github.com/kalcaddle/kodbox"
  },
  "configItem": {
    "pluginAuth": {
      "type": "userSelect",
      "value": {
        "user": 1
      },
      "className": "hidden",
      "display": "使用权限",
      "require": 1
    },
    "serviceUrl": {
      "type": "input",
      "value": "http://rag-api:8787",
      "display": "RAG 服务内网地址",
      "desc": "Docker 共用私有网络时填写 http://rag-api:8787，切勿指向公开未经保护的 API。",
      "require": 1
    },
    "serviceKey": {
      "type": "input",
      "value": "",
      "display": "RAG 服务访问密钥",
      "desc": "与 .env 中 RAG_API_KEY 完全一致。仅 KodBox 服务端会读取，不发送给浏览器。",
      "require": 1
    }
  }
}
