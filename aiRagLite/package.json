{
  "id": "aiRagLite",
  "name": "AI 智能检索（自建）",
  "title": "AI 智能检索（自建）",
  "version": "0.8.1",
  "category": "tools",
  "source": {
    "className": "font-icon ri-search-eye-line bg-blue-6"
  },
  "description": "KodBox AI Agent：文件定位优先复用 RAG 索引，短文件名直查且可点击来源；明确查看目录时才调用 KodBox 列目录，避免模型盲目遍历。保留权限校验与确认保存。",
  "auther": {
    "copyright": "Community MVP",
    "homePage": "https://github.com/kalcaddle/kodbox"
  },
  "configItem": {
    "pluginAuth": {
      "type": "userSelect",
      "value": {
        "user": 1
      },
      "className": "hidden",
      "display": "使用权限",
      "require": 1
    },
    "serviceUrl": {
      "type": "input",
      "value": "http://rag-api:8787",
      "display": "RAG 服务内网地址",
      "desc": "Docker 共用私有网络时填写 http://rag-api:8787，切勿指向公开未经保护的 API。",
      "require": 1
    },
    "serviceKey": {
      "type": "input",
      "value": "",
      "display": "RAG 服务访问密钥",
      "desc": "与 .env 中 RAG_API_KEY 完全一致。仅 KodBox 服务端会读取，不发送给浏览器。",
      "require": 1
    }
  }
}
